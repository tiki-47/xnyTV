<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1d27">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="TV Client - 初始设置"
            android:textColor="#63b3ed"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="配置展示网址和可选的服务器连接"
            android:textColor="#718096"
            android:textSize="13sp" />

        <!-- ===== 展示 URL（必填）===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="展示网址（必填）"
            android:textColor="#e2e8f0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDisplayUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="#0d1117"
            android:hint="http://192.168.1.100/dashboard"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#e2e8f0"
            android:textColorHint="#4a5568"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="TV 开机后全屏展示此网址，不需要后端服务也能正常显示"
            android:textColor="#718096"
            android:textSize="12sp" />

        <!-- ===== 分割线 ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="#2d3748" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="远程管理（可选，不填则纯本地运行）"
            android:textColor="#a0aec0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ===== 服务器 WebSocket 地址（可选）===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="服务器 WebSocket 地址（可选）"
            android:textColor="#a0aec0"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etWsUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="#0d1117"
            android:hint="ws://192.168.1.100:8080/ws"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#e2e8f0"
            android:textColorHint="#4a5568"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="填写后可接受服务端远程指令；留空则仅本地运行"
            android:textColor="#718096"
            android:textSize="12sp" />

        <!-- ===== 设备名称 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="设备名称（可选）"
            android:textColor="#a0aec0"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#0d1117"
            android:hint="如：生产车间-1号屏"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#e2e8f0"
            android:textColorHint="#4a5568"
            android:textSize="14sp" />

        <!-- ===== 设备位置 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="设备位置（可选）"
            android:textColor="#a0aec0"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="#0d1117"
            android:hint="如：1号车间-入口"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#e2e8f0"
            android:textColorHint="#4a5568"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#3182ce"
            android:text="保存并启动"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#718096"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
